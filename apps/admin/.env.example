# Key names only, never values. Copy to apps/admin/.env.local (git-ignored) for local work
# and set the same names in the hosting provider's environment variables.

# Firebase Admin (server only). Create a NEW service-account key; never commit it.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on one line with literal \n sequences.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Web API key of the Firebase project (public identifier, used for server-side password checks).
FIREBASE_WEB_API_KEY=

# Google sign-in (public web config, same values as the Firebase web app; leave empty to hide the button).
# Also add your domain (localhost, production host) under Authentication > Settings > Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Optional, defaults to <project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Public site refresh after Publish and after a project change. Both must be set for the refresh to work.
WEB_BASE_URL=
REVALIDATE_SECRET=

# Optional: project slug that owns the existing tours which have no propertySlug yet.
LEGACY_PROPERTY_SLUG=

# Used only by scripts/bootstrap-super-admin.mjs (optional password, at least 12 characters).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
